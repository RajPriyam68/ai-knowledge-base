# =============================================================================
# AI Knowledge Base - Root Environment Variables
# Copy to .env and fill in values. Never commit the real .env file.
# =============================================================================

# --- Database ---
POSTGRES_USER=akb
POSTGRES_PASSWORD=akb_password
POSTGRES_DB=ai_knowledge_base

# --- Backend ---
PORT=5000
DATABASE_URL=postgresql://akb:akb_password@localhost:5432/ai_knowledge_base?schema=public

# --- JWT ---
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- App ---
NODE_ENV=development
CLIENT_URL=http://localhost:3000
API_URL=http://localhost:5000/api
CORS_ORIGINS=http://localhost:3000
# Verify email by an HTTP request is treated as verified (no SMTP configured).
EMAIL_VERIFICATION_REQUIRED=false
# When true, forgot-password tokens are logged instead of emailed.
LOG_EMAILS_INSTEAD_OF_SEND=true

# --- AI (Gemini) ---
# Get a key at https://aistudio.google.com/apikey
# Leave GEMINI_API_KEY empty to run in offline demo mode (deterministic answers).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_TOKENS=1024
GEMINI_TEMPERATURE=0.2

# --- Embeddings (all-MiniLM-L6-v2, 384 dims) ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_CACHE_DIR=./.model-cache

# --- Storage ---
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20
ALLOWED_EXTENSIONS=pdf,docx,txt,md

# --- RAG pipeline ---
RAG_CHUNK_SIZE_TOKENS=1000
RAG_CHUNK_OVERLAP_TOKENS=200
RAG_TOP_K=5
RAG_LANGUAGE=auto

# --- Admin bootstrap (created on first run if no admins exist) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin123!

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://172.11.9.199:5000/api
