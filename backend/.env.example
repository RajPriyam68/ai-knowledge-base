# Backend environment configuration - copy to .env and adjust
NODE_ENV=development
PORT=5000

# PostgreSQL connection
DATABASE_URL=postgresql://akb:akb_password@localhost:5432/ai_knowledge_base?schema=public

# JWT secrets - generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=dev_access_secret_change_me_1234567890
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_1234567890
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# App
CLIENT_URL=http://localhost:3000
API_URL=http://localhost:5000/api
CORS_ORIGINS=http://localhost:3000
EMAIL_VERIFICATION_REQUIRED=false
LOG_EMAILS_INSTEAD_OF_SEND=true

# SMTP (optional - leave empty to log emails in dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=

# AI - Gemini
# Get a key at https://aistudio.google.com/apikey
# Leave GEMINI_API_KEY empty for offline demo mode
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MAX_TOKENS=1024
GEMINI_TEMPERATURE=0.2

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_CACHE_DIR=./.model-cache

# Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20
ALLOWED_EXTENSIONS=pdf,docx,txt,md

# RAG
RAG_CHUNK_SIZE_TOKENS=1000
RAG_CHUNK_OVERLAP_TOKENS=200
RAG_TOP_K=5
RAG_LANGUAGE=auto

# Admin bootstrap
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin123!

# Jobs
JOB_CLEANUP_INTERVAL_MINUTES=15
